{
 "id": "MokiPopsLeadHook",
 "versionId": "0001",
 "name": "MOKIPOPS — wholesale & events lead form",
 "nodes": [
  {
   "parameters": {
    "httpMethod": "POST",
    "path": "mokipops-lead",
    "responseMode": "responseNode",
    "options": {
     "allowedOrigins": "*"
    }
   },
   "id": "fa5061a2-93ca-4c35-ae6c-74f0ff3dc4af",
   "name": "Wholesale form POST",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    300
   ],
   "webhookId": "7f1d6c2e-5b1a-4c1e-9a1e-mokipopslead1",
   "notes": "Public URL = WEBHOOK_URL + /webhook/mokipops-lead (via the ngrok service). wholesale.html posts JSON here.",
   "notesInFlow": true
  },
  {
   "parameters": {
    "jsCode": "const b = $input.first().json.body || {};\nconst clean = v => String(v ?? '').trim().slice(0, 500);\nconst email = clean(b.email).toLowerCase();\nconst ok = !clean(b.website) /* honeypot */ && /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email) && clean(b.name).length > 1;\nconst lead = {\n  at: new Date().toISOString(), name: clean(b.name), email, phone: clean(b.phone), company: clean(b.company),\n  interest: clean(b.interest) || 'Wholesale', message: clean(b.message).slice(0, 2000), source: clean(b.source) || 'wholesale.html',\n  ip: $input.first().json.headers?.['x-forwarded-for'] || '', ua: ($input.first().json.headers?.['user-agent'] || '').slice(0, 200),\n};\nreturn [{ json: { ok, lead, log_b64: Buffer.from(JSON.stringify(lead) + '\\n').toString('base64') } }];\n"
   },
   "id": "964b615f-ffc4-4153-a192-2cc03c576cda",
   "name": "Validate",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    300
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "9f98cc40-89d7-4eb7-8e93-0ddd705e6842",
       "leftValue": "={{ $json.ok }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "8dcddd4a-a5e4-442f-beb1-88ebe4f5c9c0",
   "name": "Valid?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    440,
    300
   ]
  },
  {
   "parameters": {
    "command": "=mkdir -p /data/contacts && echo '{{ $json.log_b64 }}' | base64 -d >> /data/contacts/leads.jsonl"
   },
   "id": "2b4d5239-c24a-43d3-aed1-af8f53d6b476",
   "name": "Append leads.jsonl",
   "type": "n8n-nodes-base.executeCommand",
   "typeVersion": 1,
   "position": [
    660,
    200
   ],
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "fromEmail": "={{ 'MOKIPOPS Leads <' + ($env.FUNNEL_FROM || 'moreflavor@mokipops.com') + '>' }}",
    "toEmail": "={{ $env.LEAD_NOTIFY_TO || 'moreflavor@mokipops.com' }}",
    "subject": "={{ 'New ' + $('Validate').first().json.lead.interest + ' lead: ' + $('Validate').first().json.lead.name + ($('Validate').first().json.lead.company ? ' · ' + $('Validate').first().json.lead.company : '') }}",
    "emailFormat": "text",
    "text": "={{ Object.entries($('Validate').first().json.lead).map(([k,v]) => k.padEnd(9) + ' ' + v).join('\\n') + '\\n\\nReply to this email to answer them directly.' }}",
    "options": {
     "replyTo": "={{ $('Validate').first().json.lead.email }}",
     "appendAttribution": false
    }
   },
   "id": "7a5f9d34-c9f4-4505-bfea-5c2cf6002ade",
   "name": "Email the team",
   "type": "n8n-nodes-base.emailSend",
   "typeVersion": 2.1,
   "position": [
    880,
    200
   ],
   "credentials": {
    "smtp": {
     "id": "MokiPopsSmtp",
     "name": "MOKIPOPS mail (SMTP)"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "respondWith": "json",
    "responseBody": "={{ JSON.stringify({ ok: true }) }}",
    "options": {
     "responseHeaders": {
      "entries": [
       {
        "name": "Access-Control-Allow-Origin",
        "value": "*"
       }
      ]
     }
    }
   },
   "id": "e45dfb28-0b7a-4512-8d0d-2ac78f45218e",
   "name": "Respond OK",
