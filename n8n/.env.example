# Copy to .env — never commit .env (git-ignored). Everything runs on this Mac.

# ── Social posting (mokipops-daily-post.json) ─────────────────────────────
# Meta Page access token (System User, never expires). Scopes:
#   pages_manage_posts pages_read_engagement pages_show_list publish_video
#   instagram_basic instagram_content_publish business_management
META_PAGE_TOKEN=
FB_PAGE_ID=1779805528922936
IG_USER_ID=                 # ./verify_meta.sh prints it
GRAPH_VERSION=v23.0
QUEUE_URL=https://borngifted.github.io/mokipops-reel/social-queue.json
DRY_RUN=false               # true = run everything except the real Meta / email calls
FORCE_POST_ID=              # e.g. 2026-10-01-facility to re-run one slot

# ── Funnel emails (mokipops-funnel-send.json) — SMTP login lives in n8n Credentials ──
FUNNEL_CAMPAIGN=A2          # A1 A2 (buyers) · B1 B2 B3 (b2b)
FUNNEL_DAILY_CAP=40         # per click; keep ≤50/day on a domain that just started sending itself
FUNNEL_PAUSE_SECONDS=30
FUNNEL_FROM=moreflavor@mokipops.com
# Only for the manual sender (n8n/mailer.py); n8n keeps its own copy in Credentials.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=moreflavor@mokipops.com
SMTP_PASS=                  # mailbox password or an app password if MFA is on

# ── Wholesale form → lead webhook (mokipops-lead-webhook.json) ─────────────
LEAD_NOTIFY_TO=moreflavor@mokipops.com
NGROK_AUTHTOKEN=            # dashboard.ngrok.com → Your Authtoken
NGROK_DOMAIN=               # dashboard.ngrok.com → Domains → the free static domain, e.g. mokipops.ngrok-free.app
WEBHOOK_URL=                # https://<NGROK_DOMAIN>/   (trailing slash)

# ── n8n itself ─────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
