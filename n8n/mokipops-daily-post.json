   },
   "id": "0cf70ccd-69e1-404e-9a67-d7c271027f15",
   "name": "IG: publish",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    2740,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "const carry = $('Evaluate status').first().json;\nconst ig = $input.first().json;\nconst sd = $getWorkflowStaticData('global');\nsd.posted = sd.posted || {};\nsd.posted[carry.post_id] = { ...(sd.posted[carry.post_id] || {}), ig_id: ig.id || null, done_at: new Date().toISOString() };\nif (sd.poll) delete sd.poll[carry.creation_id];\nreturn [{ json: { post_id: carry.post_id, key: carry.key, facebook_id: carry.fb_id, facebook_error: carry.fb_error, instagram_id: ig.id || null } }];\n"
   },
