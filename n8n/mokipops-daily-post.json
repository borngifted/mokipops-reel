   "id": "7d763b62-4c88-490a-819b-37c895efe890",
   "name": "Fetch queue",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    440,
    300
   ],
   "notes": "social-queue.json on GitHub Pages. Regenerate with n8n/build_queue.py and ./publish.sh",
   "notesInFlow": true
  },
  {
   "parameters": {
    "jsCode": "// Choose today's row (America/New_York) that hasn't been posted yet.\nconst cfg = $('Config').first().json;\nconst body = $input.first().json;\nconst queue = Array.isArray(body) ? body : (body.posts || []);\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: cfg.timezone }); // YYYY-MM-DD\nconst sd = $getWorkflowStaticData('global');\nsd.posted = sd.posted || {};\n\nlet rows;\nif (cfg.force_id) {\n  rows = queue.filter(p => p.id === cfg.force_id);\n  if (!rows.length) throw new Error(`FORCE_POST_ID ${cfg.force_id} not found in queue`);\n} else {\n  rows = queue.filter(p => p.date === today && !sd.posted[p.id]);\n}\nif (!rows.length) {\n  const future = queue.filter(p => p.date > today).length;\n  console.log(`Nothing to post for ${today}. ${future} future slots left in queue.`);\n  return [];\n}\nreturn rows.slice(0, 1).map(r => ({ json: { ...cfg, ...r, today } }));\n"
   },
