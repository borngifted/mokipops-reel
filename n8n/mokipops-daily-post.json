   "id": "e63480ae-1216-4f42-ad83-a9539e1ee89e",
   "name": "IG: create image container",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1580,
    540
   ]
  },
  {
   "parameters": {
    "jsCode": "// Both container nodes feed in here; only one ran.\nconst post = $('Pick post').first().json;\nconst ig = $input.first().json;\nif (!ig || !ig.id) throw new Error('Instagram container was not created: ' + JSON.stringify(ig));\nlet fb = null;\ntry { fb = $('FB: upload video').first().json; } catch (e) {}\nif (!fb) { try { fb = $('FB: post photo').first().json; } catch (e) {} }\nconst fb_id = fb && (fb.id || fb.post_id) || null;\nconst fb_error = fb && fb.error ? (fb.error.message || JSON.stringify(fb.error)) : null;\n\n// Record the Facebook side immediately so a retry never double-posts it.\nconst sd = $getWorkflowStaticData('global');\nsd.posted = sd.posted || {};\nsd.posted[post.id] = { at: new Date().toISOString(), fb_id, fb_error, ig_id: null, creation_id: ig.id };\nreturn [{ json: { post_id: post.id, key: post.key, creation_id: ig.id, fb_id, fb_error, attempts: 0 } }];\n"
   },
   "id": "7db72abe-80eb-43ce-b450-2f59accc041c",
   "name": "Normalize",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1820,
    400
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "={{ $('Pick post').first().json.graph_host }}/{{ $('Pick post').first().json.graph_version }}/{{ $json.creation_id }}",
    "options": {
     "timeout": 30000
    },
    "sendQuery": true,
    "queryParameters": {
     "parameters": [
      {
       "name": "fields",
       "value": "status_code,status"
      },
      {
       "name": "access_token",
       "value": "={{ $('Pick post').first().json.access_token }}"
      }
     ]
    }
   },
   "id": "c5a70a42-e69b-4ace-a106-61162e2bd976",
   "name": "IG: check status",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    2060,
    400
   ]
  },
  {
   "parameters": {
    "jsCode": "const carry = $('Normalize').first().json;\nconst r = $input.first().json;\nconst sd = $getWorkflowStaticData('global');\nsd.poll = sd.poll || {};\nconst n = (sd.poll[carry.creation_id] || 0) + 1;\nsd.poll[carry.creation_id] = n;\nconst code = r.status_code;\nif (code === 'ERROR' || code === 'EXPIRED') {\n  throw new Error(`Instagram container ${carry.creation_id} is ${code}: ${r.status || ''}`);\n}\nif (n > 40 && code !== 'FINISHED') {\n  throw new Error(`Instagram container ${carry.creation_id} still ${code} after ${n} checks`);\n}\nreturn [{ json: { ...carry, status_code: code, attempts: n, done: code === 'FINISHED' } }];\n"
   },
   "id": "d2f01a11-527b-400e-9415-bbaa321936ce",
   "name": "Evaluate status",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2280,
    400
   ],
   "notes": "Images finish instantly; reels take 30 s – 3 min. Polls every 20 s, gives up after 40 tries.",
   "notesInFlow": true
  },
  {
   "parameters": {
    "conditions": {
     "options": {
